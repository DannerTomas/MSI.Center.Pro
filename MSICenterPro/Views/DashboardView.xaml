<UserControl x:Class="MSICenterPro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MSICenterPro.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="820" d:DesignWidth="1160">

    <Grid Margin="32,14,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Tag="enter" Margin="0,8,0,0">
            <TextBlock Text="{Binding Monitor.GreetingTitle}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

        <!-- ===================== left: metric cards ===================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU ring -->
            <materialDesign:Card Grid.Row="0" Grid.Column="0" UniformCornerRadius="8" Padding="22,16"
                                 Tag="enter">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="CPU 使用率" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                    <controls:RingProgress Grid.Row="1" Width="188" Height="188" Margin="0,10,0,4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Value="{Binding Monitor.CpuUsage}">
                        <TextBlock Text="{Binding Monitor.CpuUsageText}"
                                   FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </controls:RingProgress>
                </Grid>
            </materialDesign:Card>

            <!-- GPU ring -->
            <materialDesign:Card Grid.Row="0" Grid.Column="2" UniformCornerRadius="8" Padding="22,16"
                                 Tag="enter">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="GPU 使用率" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                    <controls:RingProgress Grid.Row="1" Width="188" Height="188" Margin="0,10,0,4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Value="{Binding Monitor.GpuUsage}">
                        <TextBlock Text="{Binding Monitor.GpuUsageText}"
                                   FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </controls:RingProgress>
                </Grid>
            </materialDesign:Card>

            <!-- Disk card -->
            <materialDesign:Card Grid.Row="2" Grid.Column="0" UniformCornerRadius="8" Padding="24,16"
                                 Tag="enter">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="硬盘" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Monitor.DiskUsagePercent, StringFormat={}{0:0}}"
                                   FontSize="36" FontWeight="SemiBold" />
                        <TextBlock Text="%" FontSize="14" Margin="4,0,0,6" VerticalAlignment="Bottom"
                                   Opacity="0.65" />
                    </StackPanel>
                    <ProgressBar Margin="0,10,0,0" Height="8"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 Value="{Binding Monitor.DiskUsagePercent}" />
                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="{Binding Monitor.DiskFreeGb, StringFormat={}{0:0} GB 可用}"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CleanDiskCommand}" HorizontalAlignment="Right"
                                Padding="14,7">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Broom" Width="15" Height="15"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="磁盘清理" Margin="8,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Memory card -->
            <materialDesign:Card Grid.Row="2" Grid.Column="2" UniformCornerRadius="8" Padding="24,16"
                                 Tag="enter">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="内存" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Monitor.MemoryUsage, StringFormat={}{0:0}}"
                                   FontSize="36" FontWeight="SemiBold" />
                        <TextBlock Text="%" FontSize="14" Margin="4,0,0,6" VerticalAlignment="Bottom"
                                   Opacity="0.65" />
                    </StackPanel>
                    <ProgressBar Margin="0,10,0,0" Height="8"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 Value="{Binding Monitor.MemoryUsage}" />
                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="{Binding Monitor.MemoryUsedGb, StringFormat={}已用 {0:0.0} GB}"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding FreeMemoryCommand}" HorizontalAlignment="Right"
                                Padding="14,7">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Memory" Width="15" Height="15"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="内存释放" Margin="8,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- ===================== right: system info ===================== -->
        <materialDesign:Card Grid.Column="2" UniformCornerRadius="8" Padding="0" Tag="enter">
            <Grid Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- title -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <!-- divider -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <!-- divider -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <!-- ec status -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="系统信息" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,0,0,6" />

                <!-- GPU group -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPU 名字" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.GpuName}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" TextAlignment="Right"
                               MaxWidth="240" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPU 频率" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.GpuClock}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </Grid>
                <Grid Grid.Row="3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="VRAM 频率" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.GpuVram}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </Grid>
                <Grid Grid.Row="4" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPU 温度" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.GpuTemperature}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </Grid>
                <Grid Grid.Row="5" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPU 风扇" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.GpuFan1}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </Grid>
                <Grid Grid.Row="6" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="单精度 TFLOPS" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.SingleTflops}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </Grid>

                <Border Grid.Row="7" Height="1" Margin="0,4" Opacity="0.25"
                        Background="{DynamicResource MaterialDesign.Brush.Secondary}" />

                <!-- CPU group -->
                <Grid Grid.Row="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU 名字" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.CpuName}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" TextAlignment="Right"
                               MaxWidth="240" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Grid Grid.Row="9" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU 频率" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.CpuClock}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </Grid>
                <Grid Grid.Row="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU 温度" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.CpuTemperature}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </Grid>
                <Grid Grid.Row="11" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU 风扇" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Monitor.CpuFanSpeed}" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </Grid>

                <Border Grid.Row="12" Height="1" Margin="0,4" Opacity="0.25"
                        Background="{DynamicResource MaterialDesign.Brush.Secondary}" />

                <!-- RAM / SSD -->
                <Grid Grid.Row="13" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RAM 容量" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Text="{Binding Monitor.TotalMemoryGb, StringFormat={}{0:0} GB}" />
                </Grid>
                <Grid Grid.Row="14" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RAM 可用" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Text="{Binding Monitor.MemoryAvailableGb, StringFormat={}{0:0.0} GB}" />
                </Grid>
                <Grid Grid.Row="15" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="固态硬盘" Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Opacity="0.65" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Text="{Binding Monitor.DiskFreeGb, StringFormat={}{0:0.00} GB 可用}" />
                </Grid>

                <TextBlock Grid.Row="16" Text="{Binding Monitor.EcStatus}"
                           Foreground="{DynamicResource App.Warning}"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           TextWrapping="Wrap" Margin="0,8,0,0" VerticalAlignment="Bottom" />
            </Grid>
        </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
