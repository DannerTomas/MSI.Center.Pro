<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MSICenterPro.Controls">

    <!-- ==================== RingProgress default style ==================== -->
    <Style TargetType="{x:Type controls:RingProgress}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RingProgress}">
                    <Grid>
                        <Ellipse x:Name="PART_Track" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="{DynamicResource App.RingTrack}" />
                        <Path x:Name="PART_Arc" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Stroke="{DynamicResource App.RingValue}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
